# Dependencies
node_modules/

# Build output
dist/
dist-update/
dist-ssr/
web-build/
*.tsbuildinfo

# Environment and secrets — never commit these
.env
.env.*
!.env.example
backend/secrets/
*.key
*.pem
*.p12
*.p8
*.jks
*.keystore
*.mobileprovision
certs/
*.local

# Firebase / Google config and service-account keys. The Android build reads google-services.json
# from the worker-mobile folder (EAS_NO_VCS=1 and .easignore), not from git, so builds keep working.
google-services.json
GoogleService-Info.plist
*service-account*.json
fcm-key.json
# EAS local build credentials
credentials.json

# Worker photos and videos uploaded to the backend
backend/uploads/

# Expo / React Native
.expo/
.expo-shared/
expo-env.d.ts
android/
ios/
*.apk
*.aab
*.ipa

# Temporary helper scripts
backend/tmp-*.ts

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python virtual environment and caches
.venv/
__pycache__/
*.py[cod]

# Tool caches
.eslintcache
.cache/

# Editors and OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Company calendar documents uploaded for review (stay on the server)
backend/calendar-documents/

# Offline OCR language data, copied from node_modules at runtime
backend/.ocr-data/

# Claude Code: installed skills and personal settings stay on each developer's machine
.claude/

# Codebase knowledge graph (graphify), regenerated on demand
graphify-out/

# Scratch and backup files, test output
*.orig
*.bak
*.pre-*
screenshots/
playwright-report/
test-results/
coverage/

# Local backups (they hold database dumps and evidence uploads), builds and the launcher binary
backups/
builds/
*.exe
*.dump
*.sql.gz
