# PostgreSQL connection. The database is created by `npm run db:create` if it does not exist.
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/quality_monitoring

PORT=4000

# The plant's timezone (IANA name). Shift times, "today" and the Plant Calendar dates are read
# in this zone, so the schedule stays right even if the server's clock runs elsewhere.
PLANT_TIMEZONE=Asia/Kolkata

# Use long random strings in production.
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Set to 1 to stop the backend sending phone notifications (useful offline).
PUSH_DISABLED=0

# Folder where photos and videos are stored (relative to backend/).
UPLOAD_DIR=uploads

# Worker web app (iPhone / PC), served at /app. Built with `npm run build:web` in worker-mobile.
# WORKER_WEB_DIR=../worker-mobile/dist

# HTTPS for the worker web app. iPhones only allow the live camera preview, "Add to Home Screen"
# and notifications on HTTPS with a certificate the phone trusts. HTTP on PORT stays on for the
# Android app and the admin panel. See README → "Worker web app".
# HTTPS_PORT=4443
# HTTPS_KEY_FILE=certs/server-key.pem
# HTTPS_CERT_FILE=certs/server.pem

# Browser notification keys. Leave unset: a key pair is created once and kept in the database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:quality@yourcompany.com

# Key used to encrypt passwords so the Super Admin can view them. Leave unset: a key is created in
# secrets/password-view.key on first use. Back that file up with the database.
# PASSWORD_VIEW_KEY=            (base64, 32 bytes)
# PASSWORD_VIEW_KEY_FILE=secrets/password-view.key

# Passwords for the seeded accounts (`npm run db:seed`). Change them after first login.
SEED_ADMIN_PASSWORD=admin123
SEED_WORKER_PASSWORD=worker123
