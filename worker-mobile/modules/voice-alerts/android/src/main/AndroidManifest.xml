<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- The voice service speaks alerts in the foreground (media playback), keeping the phone awake while it speaks. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <!--
      Receives every Firebase message before expo-notifications' own service (priority 10 > -1).
      It extends that service and calls it first, so notifications behave exactly as before.
    -->
    <service
      android:name="expo.modules.voicealerts.VoiceMessagingService"
      android:exported="false">
      <intent-filter android:priority="10">
        <action android:name="com.google.firebase.MESSAGING_EVENT" />
      </intent-filter>
    </service>

    <!-- Speaks queued alerts with Android text-to-speech, then stops. -->
    <service
      android:name="expo.modules.voicealerts.VoiceAlertService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />
  </application>
</manifest>
